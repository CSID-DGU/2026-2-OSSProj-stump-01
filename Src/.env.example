# 이 파일을 복사해서 .env를 만들고 값을 채운다. .env는 커밋하지 않는다.

# 로컬 DB (docker compose)
POSTGRES_USER=treemate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=treemate
POSTGRES_PORT=5432

# 기상청 API (data.go.kr 일반 인증키, Decoding 값). 같은 키로 아래 3개 서비스를 모두 활용 신청해야 한다
#  - 지상(종관, ASOS) 일자료 조회서비스: 나이테용 일자료 (data/weather.py)
#  - 단기예보 조회서비스, 기상특보 조회서비스: 오늘의 날씨 (GET /weather/today)
KMA_SERVICE_KEY=

# API 서버 (Src/backend)
PORT=4000
# 로그인 토큰 서명 키. 아무 긴 문자열이나 넣는다(예: openssl rand -hex 32)
JWT_SECRET=change-me
